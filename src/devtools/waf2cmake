#!/usr/bin/env python3
# waf2cmake
import argparse
from pathlib import Path

import time
from alive_progress import alive_bar

from waftocmake.parser import WafParser
from waftocmake.generators.project import generate
from waftocmake.generators.rootproject import write_rootproject
import logging

class bcolors:
    HEADER = '\033[95m'
    OKBLUE = '\033[94m'
    OKCYAN = '\033[96m'
    OKGREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'

logger = logging.getLogger(__name__)
projects = []

def convert_project(wscript: Path):
    parser = WafParser()
    project = parser.parse(wscript)
    outfile = wscript.parent / "CMakeLists.txt"

    generate(project, outfile)
    logger.info("*----------------------------------*")
    logger.info("*")
    logger.info(f" [+] Converted {wscript}")

def scan_tree(root: Path, count):
    for wscript in root.rglob("wscript"):
        if wscript.parent != Path(root):
            convert_project(wscript)
            time.sleep(0.01)
            yield

def count_projects(root: Path):
    count = 0;
    for wscript in root.rglob("wscript"):
        if wscript.is_file() and wscript.parent != Path(root):
            count += 1
            projects.append(wscript.parent)

    return count

def main():
    ap = argparse.ArgumentParser()

    ap.add_argument("path", help="Root directory or single wscript")
    ap.add_argument('-v', '--verbose', action='store_true', help="Verbose")  # on/off flag
    ap.add_argument('-n', '--name', default='cssv34-client', help="APPNAME")
    args = ap.parse_args()

    path = Path(args.path)
    count = 1;

    if not path.is_file():
        count = count_projects(path)

    # clear
    open(Path('waf2cmake.log'), "w", encoding="utf-8")

    # open log
    logging.basicConfig(filename='waf2cmake.log', level=logging.INFO)

    print(f"{bcolors.HEADER}waf2cmake stats: \n{bcolors.OKBLUE}",
    f"root: {bcolors.BOLD}{path};",
    f"single: {path.is_file()};", 
    f"total: {count}",
    f"{bcolors.ENDC}"
    )
    
    rootWscript = Path(args.path + "/wscript")
    if path.is_file():
        convert_project(path)
    else:
        with alive_bar(count, ctrl_c=0) as bar:
            for i in scan_tree(path, count):
                bar()

    print(f"{bcolors.HEADER} Root waifulib script: {bcolors.BOLD}'{rootWscript.resolve()}'{bcolors.ENDC}");

    outrootproj = rootWscript.parent / "CMakeLists.txt"
    write_rootproject(outrootproj, args.name, projects)
    print(f"{bcolors.OKGREEN} Generated Root 'CMakeLists.txt'{bcolors.ENDC}")
    print(f"{bcolors.HEADER}Full log can be found in 'waf2cmake.log'{bcolors.ENDC}")


if __name__ == "__main__":
    main()