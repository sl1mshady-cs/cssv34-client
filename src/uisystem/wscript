def build(bld):
    source = [
        'uidocument.cpp',
        'uifileinterface.cpp',
        'uihelpers.cpp',
        'uirenderinterface.cpp',
        'uisystem.cpp',
        'mainmenu.cpp',
        'uiimage.cpp',
        'stb_image_Impl.cpp',
        'uisysteminterface.cpp'
    ]

    includes = [
        '.',
        '../thirdparty',
        '../public',
        '../public/tier0',
        '../public/tier1',
        '../game/shared'
    ]

    defines = []

    libs = ['tier0', 'tier1', 'tier2', 'vstdlib', 'vtf', 'bitmap', 'mathlib', 'rmlui', 'FT2', 'LEGACY_STDIO_DEFINITIONS']

    if bld.env.DEST_OS == 'android':
        libs += ['ANDROID_SUPPORT']

    bld.shlib(
        source       = source,
        target       = PROJECT_NAME,
        name         = PROJECT_NAME,
        features     = 'c cxx',
        includes     = includes,
        defines      = defines,
        use          = libs,
        subsystem    = bld.env.MSVC_SUBSYSTEM,
        idx          = bld.get_taskgen_count()
    )